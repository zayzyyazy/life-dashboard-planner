# OpenAI
OPENAI_API_KEY=sk-your-key-here
OPENAI_DEFAULT_MODEL=gpt-4o-mini
OPENAI_PLANNING_MODEL=gpt-4o-mini
OPENAI_TRANSCRIPTION_MODEL=whisper-1

# Groq — free voice transcription (preferred over OpenAI when set)
GROQ_API_KEY=
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# Server
PORT=3847
DATA_DIR=./data
TZ=Europe/Berlin

# Obsidian vault (Brain-Vault)
VAULT_PATH=/Users/zay/Documents/Brain-Vault
BRAIN_DATA_DIR=/Users/zay/.brain
# Cloud git sync (optional)
# VAULT_GIT_SYNC=true
# VAULT_GIT_REMOTE=https://github.com/YOU/brain-vault.git

# Proactive Telegram outreach (agent texts you)
MORNING_OUTREACH_ENABLED=true
MORNING_OUTREACH_CRON=0 8 * * *
EVENING_CHECKIN_ENABLED=false
EVENING_CHECKIN_CRON=0 20 * * *
STALE_PROJECT_NUDGE_ENABLED=false
STALE_PROJECT_NUDGE_CRON=0 14 * * *
STALE_PROJECT_DAYS=5

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_ENABLE_VOICE=true
TELEGRAM_ENABLE_TEXT=true
TELEGRAM_ENABLE_COMMANDS=true

# GitHub — auto-watch your repos (recommended)
# Create token: GitHub → Settings → Developer settings → Personal access tokens
# Classic token: scope 'repo' (private) or 'public_repo' (public only)
# Fine-grained: grant read access to Contents, Issues, Pull requests on your repos
GITHUB_TOKEN=ghp_your_token
GITHUB_USERNAME=
GITHUB_AUTO_SYNC=true
# Optional: watch only these repos (comma-separated). Leave empty to sync your latest repos.
# Include Leaping/Marie repos explicitly if auto-sync misses them:
# GITHUB_WATCH_REPOS=zayzyyazy/life-dashboard-planner,org/leaping-mcp
GITHUB_SYNC_LIMIT=20

# Daily brief — email + Telegram every morning
DAILY_BRIEF_ENABLED=true
DAILY_BRIEF_CRON=0 7 * * *

# Reminders — email + Telegram when due
REMINDERS_ENABLED=true
REMINDER_CHECK_CRON=*/1 * * * *

# Idle check-in — disabled by default (was spammy)
IDLE_NUDGE_ENABLED=false
IDLE_NUDGE_HOURS=2
IDLE_NUDGE_COOLDOWN_HOURS=4
IDLE_NUDGE_CHECK_CRON=*/15 * * * *

# Chat memory — how many prior messages the agent sees
CHAT_HISTORY_LIMIT=16
CLASSIFIER_HISTORY_LIMIT=6

# Email — choose provider: smtp or resend
EMAIL_PROVIDER=smtp
EMAIL_FROM=you@gmail.com
EMAIL_TO=you@gmail.com

# SMTP (Gmail: use an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password

# Resend (alternative to SMTP)
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxx

# Security
ALLOW_SHELL=false
