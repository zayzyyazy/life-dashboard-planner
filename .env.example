# OpenAI
OPENAI_API_KEY=sk-your-key-here
OPENAI_DEFAULT_MODEL=gpt-4o-mini
OPENAI_PLANNING_MODEL=gpt-4o
OPENAI_TRANSCRIPTION_MODEL=whisper-1

# Server
PORT=3847
DATA_DIR=./data
TZ=America/New_York

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_ENABLE_VOICE=true
TELEGRAM_ENABLE_TEXT=true
TELEGRAM_ENABLE_COMMANDS=true

# Daily brief schedule (cron: minute hour day month weekday)
# Default: 7:00 AM every day
DAILY_BRIEF_CRON=0 7 * * *

# Email — choose provider: smtp or resend
EMAIL_PROVIDER=smtp
EMAIL_FROM=you@gmail.com
EMAIL_TO=you@gmail.com

# SMTP (Gmail: use an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password

# Resend (alternative to SMTP)
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxx

# GitHub (optional but recommended for higher API rate limits)
GITHUB_TOKEN=ghp_your_token

# Security
ALLOW_SHELL=false
