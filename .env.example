# OpenAI
OPENAI_API_KEY=sk-your-key-here
OPENAI_DEFAULT_MODEL=gpt-4o-mini
OPENAI_PLANNING_MODEL=gpt-4o
OPENAI_TRANSCRIPTION_MODEL=whisper-1

# Server
PORT=3847
DATA_DIR=./data
TZ=America/New_York

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_ENABLE_VOICE=true
TELEGRAM_ENABLE_TEXT=true
TELEGRAM_ENABLE_COMMANDS=true

# GitHub — auto-watch your repos (recommended)
# Create token: GitHub → Settings → Developer settings → Personal access tokens
# Scopes needed: repo (for private repos) or public_repo (public only)
GITHUB_TOKEN=ghp_your_token
GITHUB_USERNAME=
GITHUB_AUTO_SYNC=true
# Optional: watch only these (comma-separated). Leave empty to sync your latest repos.
# GITHUB_WATCH_REPOS=zayzyyazy/life-dashboard-planner,owner/other-repo
GITHUB_SYNC_LIMIT=20

# Daily brief — email + Telegram every morning
DAILY_BRIEF_ENABLED=true
DAILY_BRIEF_CRON=0 7 * * *

# Reminders — email + Telegram when due
REMINDERS_ENABLED=true
REMINDER_CHECK_CRON=*/5 * * * *

# Email — choose provider: smtp or resend
EMAIL_PROVIDER=smtp
EMAIL_FROM=you@gmail.com
EMAIL_TO=you@gmail.com

# SMTP (Gmail: use an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password

# Resend (alternative to SMTP)
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxx

# Security
ALLOW_SHELL=false
