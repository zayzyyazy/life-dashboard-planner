{
  "name": "life-planner-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0 <=22.x.x"
  },
  "scripts": {
    "postinstall": "npm install --prefix server",
    "preinstall": "node scripts/check-node.mjs",
    "predev": "node scripts/ensure-deps.mjs",
    "setup": "node scripts/ensure-deps.mjs && node scripts/check-env.mjs && npm run setup --prefix server",
    "seed:profile": "npm run seed:profile --prefix server",
    "dev": "concurrently -n server,dashboard -c blue,green \"npm run dev:server\" \"npm run dev:dashboard\"",
    "dev:server": "npm run dev --prefix server",
    "dev:dashboard": "vite",
    "restart": "bash scripts/restart-mac.sh",
    "build": "npm run build:dashboard",
    "build:dashboard": "tsc && vite build",
    "start": "node scripts/ensure-deps.mjs && npm run build:dashboard && npm run start --prefix server",
    "start:daemon": "bash scripts/start-daemon.sh",
    "install:daemon": "bash scripts/install-launchagent.sh",
    "migrate:off-desktop": "bash scripts/migrate-off-desktop.sh",
    "test:daemon": "bash scripts/test-daemon.sh",
    "docker:up": "docker compose up -d --build",
    "docker:logs": "docker compose logs -f",
    "check-env": "node scripts/check-env.mjs",
    "test:telegram": "node scripts/test-telegram.mjs",
    "test:github": "node scripts/test-github.mjs",
    "test:reminder": "node scripts/test-reminder.mjs",
    "fix:telegram": "bash scripts/fix-telegram.sh",
    "typecheck": "tsc && npm run typecheck --prefix server",
    "install:all": "node scripts/check-node.mjs && npm install && npm install --prefix server"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.3"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.1.2",
    "typescript": "^5.6.3",
    "vite": "^6.0.1"
  }
}
