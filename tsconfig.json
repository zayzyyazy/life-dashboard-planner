{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["src/main.tsx", "src/App.tsx", "src/lib/api.ts", "src/components/ChatPanel.tsx", "src/components/ProjectsPanel.tsx", "src/components/BriefPanel.tsx", "src/components/TasksPanel.tsx", "src/components/ProfilePanel.tsx", "src/components/WatchersPanel.tsx", "src/components/UpdatesPanel.tsx", "src/components/TelegramStatusPanel.tsx", "src/styles/**/*", "src/vite-env.d.ts"]
}
